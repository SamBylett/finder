# Supabase (optional for V1 — app falls back to an in-memory store when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Real provider integrations
# Set GOOGLE_PLACES_API_KEY to switch business search from mock data to the
# real Google Places API (New) — see README for setup steps. Everything else
# below is still unused in V1 (mock only).
GOOGLE_PLACES_API_KEY=

# Website analysis defaults to the real fetch+cheerio analyzer (no key needed).
# Set to "mock" to force the deterministic mock analyzer instead.
WEBSITE_ANALYZER=

# Max real Claude API calls (AI design assessment) per search — keeps cost
# predictable. Defaults to 15 if unset.
AI_ASSESSMENT_MAX_PER_SEARCH=
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=

# FindyMail contact enrichment (V2.5). Only called from an explicit "Enrich
# Contact" click or the batch "Enrich Top N" action — never automatically.
FINDYMAIL_API_KEY=

# Opportunity Score threshold a business must meet before enrichment is
# offered — keeps FindyMail credits from being spent on low-value prospects.
# Defaults to 65 if unset. See lib/enrichment-policy.ts.
ENRICHMENT_SCORE_THRESHOLD=
